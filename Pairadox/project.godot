;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Pairadox"
run/main_scene="uid://d6dypkxg6rp4"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/icon.png"

[autoload]

Globals="*uid://bkxyujukgano2"
